# Deploy
.vercel

# Model weights are never committed. They are fetched from Hugging Face at
# runtime or side-loaded from disk via the file picker.
*.litertlm
*.task
*.onnx
*.gguf
*.bin
*.safetensors
# ...except the self-hosted OCR models, which must ship for the offline claim.
!public/models/ocr/*.onnx

# LiteRT-LM wasm runtime (~102 MB) is copied out of node_modules by
# scripts/copy-wasm.mjs on install and build. Self-hosted at runtime so the app
# starts offline, but never committed.
public/litertlm-wasm/

# Private planning material must never enter this public repo.
# Strategy docs, judge recon, and win calibration live in ~/dev/Gemma Hacks only.
*Build_Plan*
*recon*
*Recon*
*calibration*
*.pdf

# Local scratch
BREAKAGES.md
tmp/
.env*

# Screenshot captures. Reference captures of third-party sites are studied
# locally and never redistributed; our own production screenshots are
# regenerated on demand by scripts/shot.mjs.
shots/
